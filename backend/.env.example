# Local development template. Never put real secrets in this file.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# SESSION_SECRET is also accepted as a signing-secret name for existing deployments.
FRONTEND_URL=http://localhost:3000

# Used only when running `npm run create-admin` for the first admin account.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password
